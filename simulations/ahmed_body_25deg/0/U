FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (40.0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (40.0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    ground
    {
        type            fixedValue;
        value           uniform (40.0 0 0); // Moving road at vehicle speed
    }
    topAndSides
    {
        type            slip;
    }
    ahmed_body
    {
        type            noSlip;
    }
}
