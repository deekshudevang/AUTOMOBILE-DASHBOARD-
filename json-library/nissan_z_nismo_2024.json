    "must_not_claim_oem_accuracy": true,
    "must_display_accuracy_class": true,
    "dimension_values_are_reference_estimates": true,
    "note": "Passing procedural geometry checks does not establish OEM surface accuracy or an exact production-vehicle match."
  }
}
